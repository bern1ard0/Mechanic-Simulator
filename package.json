{
  "name": "mechanic-simulator",
  "version": "0.1.0",
  "private": true,
  "description": "Personal mechanic simulator: your garage, AI diagnostics, and realistic car visualizations. Runs on Cloudflare. For personal use only.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute mechanic_db --remote --file=./schema.sql",
    "db:init:local": "wrangler d1 execute mechanic_db --local --file=./schema.sql"
  },
  "dependencies": {
    "hono": "^4.12.27"
  },
  "devDependencies": {
    "wrangler": "^3.114.17"
  }
}
