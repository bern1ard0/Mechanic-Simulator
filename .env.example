# This is a TEMPLATE showing which keys the app can use.
# It is safe to commit because it contains NO real values — only names.
#
# You do NOT need to touch this file. The app has a Settings page where you
# paste your keys into a form and click Save. This file is just documentation.
#
# Names only — real values live on your machine, never in the repo or in chat.

# Optional: enables the AI diagnostic guidance (Anthropic / Claude API)
ANTHROPIC_API_KEY=

# Optional: lets Diagnose pick a specific YouTube video instead of a search link
YOUTUBE_API_KEY=

# Optional: enables realistic car-photo edits (Higgsfield)
HIGGSFIELD_API_KEY=
